# Contact form (server-side only). Copy to .env.local for local testing, and set
# the same variables in Vercel > Project > Settings > Environment Variables.
# Never prefix these with VITE_: anything starting with VITE_ ships to the browser.

RESEND_API_KEY=
# Inbox that receives the messages. Never shown on the site.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. Portfolio <contact@example.com>
CONTACT_FROM_EMAIL=

# Optional: comma-separated origins allowed to post (defaults to the site's own host)
CONTACT_ALLOWED_ORIGINS=

# Optional but recommended in production: shared rate limit (Upstash free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local testing without sending anything: messages are printed in the terminal
CONTACT_DRY_RUN=1
